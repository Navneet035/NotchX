<Window x:Class="Notchify.Shell.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Notchify.Core"
        xmlns:c="clr-namespace:Notchify.Controls"
        Title="NotchX" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}"
        Width="760" Height="420">

    <Window.Resources>
        <c:BoolToVisibility x:Key="Vis" />
        <c:BoolToVisibility x:Key="NotVis" Invert="True" />

        <!-- A live activity chip on the collapsed pill -->
        <DataTemplate DataType="{x:Type core:LiveActivity}">
            <StackPanel Orientation="Horizontal" Margin="7,0" Background="Transparent" ToolTip="{Binding Detail}"
                        MouseLeftButtonUp="Activity_Click" Tag="{Binding}">
                <Grid Width="20" Height="20" VerticalAlignment="Center">
                    <Border CornerRadius="5" Visibility="{Binding HasImage, Converter={StaticResource Vis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Accent}" FontSize="13"
                               Visibility="{Binding HasImage, Converter={StaticResource NotVis}}" />
                </Grid>
                <ContentPresenter Content="{Binding CompactContent}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBlock Text="{Binding Text}" Foreground="{Binding Accent}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,0,0,0" MaxWidth="170" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Text, Converter={StaticResource Vis}}" />
                <ProgressBar Width="34" Height="3" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding Accent}"
                             Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasProgress, Converter={StaticResource Vis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- A transient island -->
        <DataTemplate DataType="{x:Type core:Island}">
            <Grid Margin="14,10,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,12,0" Background="Transparent"
                      MouseMove="IslandImage_MouseMove" Tag="{Binding}" Cursor="Hand">
                    <Border CornerRadius="9" Visibility="{Binding HasImage, Converter={StaticResource Vis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="19" Background="#1AFFFFFF" Visibility="{Binding HasImage, Converter={StaticResource NotVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Accent}" FontSize="17" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Title}" Text="{Binding Title}" FontSize="13" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="34"
                               Visibility="{Binding HasMessage, Converter={StaticResource Vis}}" />
                </StackPanel>

                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                             Foreground="{Binding Accent}" Height="5" Margin="0,8,0,0"
                             Visibility="{Binding HasProgress, Converter={StaticResource Vis}}" />

                <ItemsControl Grid.Row="2" Grid.ColumnSpan="3" ItemsSource="{Binding Actions}" Margin="0,10,0,0" HorizontalAlignment="Right"
                              Visibility="{Binding HasActions, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Tag="{Binding}" Click="IslandAction_Click" Margin="6,0,0,0" MinWidth="64">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Primary}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid x:Name="PillHost" HorizontalAlignment="Center" VerticalAlignment="Top">
            <!-- Soft shadow drawn behind the pill so the pill itself can clip to its rounded shape -->
            <Grid x:Name="ShadowHost" IsHitTestVisible="False">
                <Border x:Name="Shadow" Background="Black" Opacity="0.55" IsHitTestVisible="False"
                        Width="{Binding ActualWidth, ElementName=Pill}" Height="{Binding ActualHeight, ElementName=Pill}"
                        CornerRadius="{Binding CornerRadius, ElementName=Pill}" VerticalAlignment="Top">
                    <Border.Effect>
                        <BlurEffect Radius="18" />
                    </Border.Effect>
                </Border>
            </Grid>

            <Border x:Name="Pill" Background="{DynamicResource NotchBrush}" VerticalAlignment="Top" AllowDrop="True"
                    Width="190" Height="32" CornerRadius="0,0,16,16">
                <Grid x:Name="PillContent">
                    <!-- Optional background picture for the open notch (Settings › Appearance) -->
                    <Image x:Name="BgImage" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Collapsed" />
                    <Border x:Name="Sheen" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False" />

                    <!-- Collapsed: live activities side by side -->
                    <Grid x:Name="CompactLayer">
                        <ItemsControl x:Name="ActivityStrip" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <!-- Island: transient notification / HUD -->
                    <ContentControl x:Name="IslandLayer" Visibility="Collapsed" Focusable="False" />

                    <!-- Expanded panel -->
                    <Grid x:Name="ExpandedLayer" Visibility="Collapsed" Margin="14,8,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="Header" LastChildFill="True" Height="32">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="AddCardButton" Style="{StaticResource ChipButton}" Content="+ Add card" Visibility="Collapsed"
                                        Margin="0,0,6,0" Click="AddCard_Click" ToolTip="Add a card to Home" />
                                <Button x:Name="DoneButton" Style="{StaticResource AccentButton}" Content="Done" Visibility="Collapsed"
                                        Margin="0,0,8,0" Click="Edit_Click" ToolTip="Finish editing the layout" />
                                <TextBlock x:Name="ClockText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock x:Name="BatteryText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock x:Name="BatteryGlyph" Style="{StaticResource Icon}" FontSize="15" />
                                </StackPanel>
                                <ToggleButton x:Name="CaffeineToggle" Style="{StaticResource IconToggle}" Content="&#xE945;" ToolTip="Keep awake" Click="Caffeine_Click" />
                                <ToggleButton x:Name="EditToggle" Style="{StaticResource IconToggle}" Content="&#xE70F;" ToolTip="Edit layout: add, arrange and resize Home cards; reorder or hide tabs" Click="Edit_Click" />
                                <ToggleButton x:Name="PinToggle" Style="{StaticResource IconToggle}" Content="&#xE718;" ToolTip="Keep open" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Pop out this tab" Click="PopOut_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click" />
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" x:Name="TabScroller">
                                <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center" />
                            </ScrollViewer>
                        </DockPanel>

                        <ContentControl x:Name="TabContent" Grid.Row="1" Margin="0,8,0,0" Focusable="False" />
                    </Grid>

                    <!-- Hairline glass rim -->
                    <Border x:Name="Rim" BorderBrush="{StaticResource GlassRimBrush}" BorderThickness="1"
                            CornerRadius="{Binding CornerRadius, ElementName=Pill}" IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
