<Window x:Class="Notchify.Shell.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchX Command Palette" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height" Width="620"
        WindowStartupLocation="Manual" FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" Margin="16" Padding="10"
            BorderBrush="{StaticResource GlassRimBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" HorizontalAlignment="Left" Margin="12,0,0,0"
                           Foreground="{DynamicResource SubtleTextBrush}" FontSize="16" />
                <TextBox x:Name="Query" FontSize="17" Padding="40,10,10,10" Background="Transparent"
                         Tag="Type a command, tab, snippet, or a sum…" />
            </Grid>
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="4,8" />
            <ListBox x:Name="Results" MaxHeight="380" Focusable="False">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="15" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Subtitle}" VerticalAlignment="Center" Margin="8,0,4,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Style="{StaticResource Caption}" Margin="8,6,0,0" Foreground="{DynamicResource FaintTextBrush}"
                       Text="↑↓ to choose · Enter to run · Esc to close" />
        </StackPanel>
    </Border>
</Window>
