<UserControl x:Class="Notchify.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Notchify.Controls">
    <UserControl.Resources>
        <c:BoolToVisibility x:Key="Vis" />
        <c:BoolToVisibility x:Key="NotVis" Invert="True" />
    </UserControl.Resources>
    <Grid>
        <Grid Visibility="{Binding Media.HasSession, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="LyricsColumn" Width="0.9*" />
            </Grid.ColumnDefinitions>

            <!-- Album art with a soft glow in its own colour -->
            <Grid Width="150" Height="150" VerticalAlignment="Center" Cursor="Hand" Background="Transparent"
                  MouseLeftButtonUp="Art_Click" ToolTip="{Binding Media.SourceName}" ToolTipService.InitialShowDelay="400">
                <Border CornerRadius="16" Background="{Binding Media.ArtBrush}" Opacity="0.6" Margin="6">
                    <Border.Effect>
                        <BlurEffect Radius="26" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="16" Background="{Binding Media.ArtBrush}">
                    <Border CornerRadius="16">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Media.Art}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Title}" Text="{Binding Media.Title}" FontSize="17" />
                <TextBlock Style="{StaticResource Body}" Text="{Binding Media.Artist}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="13" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Media.SourceName}" Foreground="{DynamicResource FaintTextBrush}" />
                    <c:SpectrumBars BarCount="10" Width="44" Height="12" Margin="10,0,0,0" Fill="{Binding Media.ArtBrush}" />
                </StackPanel>

                <!-- Scrubber -->
                <Slider x:Name="Scrubber" Margin="0,12,0,0" Minimum="0" Foreground="{DynamicResource TextBrush}"
                        Thumb.DragStarted="Scrubber_DragStarted" Thumb.DragCompleted="Scrubber_DragCompleted"
                        PreviewMouseLeftButtonUp="Scrubber_MouseUp" />
                <Grid>
                    <TextBlock x:Name="Elapsed" Style="{StaticResource Caption}" FontSize="10" />
                    <TextBlock x:Name="Remaining" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right" />
                </Grid>

                <!-- Transport -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <ToggleButton x:Name="ShuffleToggle" Style="{StaticResource IconToggle}" Content="&#xE8B1;" ToolTip="Shuffle" Click="Shuffle_Click"
                                  IsEnabled="{Binding Media.CanShuffle}" />
                    <Button Style="{StaticResource BigIconButton}" Content="&#xE892;" Click="Prev_Click" Margin="8,0,0,0" />
                    <Button Style="{StaticResource BigIconButton}" Content="{Binding Media.PlayGlyph}" Click="Play_Click" Margin="6,0" FontSize="24" Width="48" Height="48" />
                    <Button Style="{StaticResource BigIconButton}" Content="&#xE893;" Click="Next_Click" Margin="0,0,8,0" />
                    <ToggleButton x:Name="RepeatToggle" Style="{StaticResource IconToggle}" Content="{Binding Media.RepeatGlyph}" ToolTip="Repeat" Click="Repeat_Click"
                                  IsEnabled="{Binding Media.CanRepeat}" />
                </StackPanel>

                <!-- App volume & speed -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" ToolTip="App volume" />
                    <Slider x:Name="AppVolume" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="AppVolume_ValueChanged" ToolTip="Volume of this app only" />
                    <ComboBox x:Name="Speed" Grid.Column="2" Width="70" Margin="10,0,0,0" SelectionChanged="Speed_SelectionChanged"
                              Visibility="{Binding Media.CanChangeRate, Converter={StaticResource Vis}}" ToolTip="Playback speed">
                        <ComboBoxItem Content="0.5×" Tag="0.5" />
                        <ComboBoxItem Content="0.75×" Tag="0.75" />
                        <ComboBoxItem Content="1×" Tag="1" />
                        <ComboBoxItem Content="1.25×" Tag="1.25" />
                        <ComboBoxItem Content="1.5×" Tag="1.5" />
                        <ComboBoxItem Content="1.75×" Tag="1.75" />
                        <ComboBoxItem Content="2×" Tag="2" />
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- Synced lyrics -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,6" x:Name="LyricsCard">
                <Grid>
                    <ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="LyricsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Margin="0,3"
                                               Foreground="{DynamicResource FaintTextBrush}" FontFamily="{StaticResource UiFont}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="NoLyrics" Style="{StaticResource Caption}" Text="No synced lyrics" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Media.HasSession, Converter={StaticResource NotVis}}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="34" Foreground="{DynamicResource FaintTextBrush}" />
            <TextBlock Style="{StaticResource Body}" Text="Nothing playing" Margin="0,8,0,0" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Caption}" Text="Play something in Spotify, Apple Music, or a browser" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
