<UserControl x:Class="Notchify.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Notchify.Controls">
    <UserControl.Resources>
        <c:BoolToVisibility x:Key="Vis" />
        <c:BoolToVisibility x:Key="NotVis" Invert="True" />
    </UserControl.Resources>
    <Grid>
        <!-- Cards are laid out here on a 12-column grid (settings.json → Behavior.HomeCards). -->
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Canvas x:Name="Host" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>

        <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="26" Foreground="{DynamicResource FaintTextBrush}" />
            <TextBlock Style="{StaticResource Body}" Text="Home is empty" HorizontalAlignment="Center" Margin="0,8,0,2" />
            <TextBlock Style="{StaticResource Caption}" Text="Click ✎ above to add cards" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- "Add a card" gallery (edit mode) -->
        <Border x:Name="Gallery" Visibility="Collapsed" CornerRadius="14" Padding="12,8,8,8" Background="#F01A1A1E">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close" Click="GalleryClose_Click" />
                    <TextBlock Style="{StaticResource Title}" Text="Add a card" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="GalleryItems" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Card pool: XAML-defined cards wait here until the layout places them. -->
        <Grid x:Name="Pool" Visibility="Collapsed">

            <!-- Clock & weather -->
            <Border Tag="clock" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel VerticalAlignment="Center">
                    <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly" MaxHeight="52">
                        <TextBlock x:Name="Time" Style="{StaticResource Big}" FontSize="40" />
                    </Viewbox>
                    <TextBlock x:Name="Date" Style="{StaticResource Caption}" FontSize="12" Margin="2,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                        <TextBlock Text="{Binding Weather.Icon}" FontSize="20" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Title}" FontSize="13">
                                <Run Text="{Binding Weather.Temperature, Mode=OneWay}" /> <Run Text="{Binding Weather.Condition, Mode=OneWay}" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="{Binding Weather.Range, Mode=OneWay}" />  <Run Text="{Binding Weather.Place, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Now Playing -->
            <Border Tag="nowplaying" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid Visibility="{Binding Media.HasSession, Converter={StaticResource Vis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="10" Background="{Binding Media.ArtBrush}" Cursor="Hand"
                                    MouseLeftButtonUp="Art_Click" ToolTip="{Binding Media.SourceName}">
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Media.Art}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Title}" Text="{Binding Media.Title}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Media.Artist}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Media.SourceName}" Foreground="{DynamicResource FaintTextBrush}" />
                            </StackPanel>
                        </Grid>
                        <c:SpectrumBars Grid.Row="1" BarCount="18" MaxHeight="22" Margin="0,6" Fill="{Binding Media.ArtBrush}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" />
                            <Button Style="{StaticResource BigIconButton}" Content="{Binding Media.PlayGlyph}" Click="Play_Click" Margin="10,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" />
                        </StackPanel>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Media.HasSession, Converter={StaticResource NotVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="24" Foreground="{DynamicResource FaintTextBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Nothing playing" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Volume & output -->
            <Border Tag="volume" Style="{StaticResource Card}" Padding="10,6">
                <StackPanel VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Content="{Binding Audio.VolumeGlyph}" Click="Mute_Click" ToolTip="Mute / unmute" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Audio.Volume, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0" ToolTip="Volume" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Audio.Volume, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ComboBox Tag="output" DisplayMemberPath="Name" ToolTip="Sound output" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Brightness -->
            <Border Tag="brightness" Style="{StaticResource Card}" Padding="10,6">
                <Grid VerticalAlignment="Center">
                    <Grid Visibility="{Binding Brightness.CanControl, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="16" ToolTip="Brightness" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Brightness.Level, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0" ToolTip="Brightness" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Brightness.Level}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center"
                               Text="This display doesn't allow brightness control (turn on DDC/CI in the monitor's menu)"
                               Visibility="{Binding Brightness.CanControl, Converter={StaticResource NotVis}}" />
                </Grid>
            </Border>

            <!-- Quick toggles -->
            <Border Tag="toggles" Style="{StaticResource Card}" Padding="8,6">
                <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ToggleButton Tag="caffeine" Style="{StaticResource IconToggle}" Content="&#xE945;" ToolTip="Keep awake" Click="Caffeine_Click" Margin="2" />
                    <ToggleButton Tag="mic" Style="{StaticResource IconToggle}" Content="&#xEC54;" ToolTip="Mute microphone everywhere" Click="Mic_Click" Margin="2" />
                    <ToggleButton Tag="hide" Style="{StaticResource IconToggle}" Content="&#xEA18;" ToolTip="Hide NotchX from screen capture" Click="Hide_Click" Margin="2" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A8;" ToolTip="Screen capture (copies to the clipboard)" Click="Capture_Click" Margin="2" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE790;" ToolTip="Colour eyedropper" Click="Eyedropper_Click" Margin="2" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Command palette" Click="Palette_Click" Margin="2" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72E;" ToolTip="Lock screen (Win+L)" Click="Lock_Click" Margin="2" />
                </WrapPanel>
            </Border>

            <!-- Sound, brightness, output, lock & quick toggles in one card -->
            <Border Tag="controls" Style="{StaticResource Card}" Padding="10,8">
                <StackPanel VerticalAlignment="Center">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Content="{Binding Audio.VolumeGlyph}" Click="Mute_Click" ToolTip="Mute / unmute" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Audio.Volume, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0" ToolTip="Volume" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Audio.Volume, StringFormat={}{0:0}}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,4" Visibility="{Binding Brightness.CanControl, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" ToolTip="Brightness" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Brightness.Level, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0" ToolTip="Brightness" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Brightness.Level}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Tag="output" DisplayMemberPath="Name" ToolTip="Sound output" />
                        <Button Grid.Column="1" Style="{StaticResource ChipButton}" Margin="6,0,0,0" Padding="9,5" Click="Lock_Click" ToolTip="Lock screen (Win+L)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="13" Margin="0,0,5,0" />
                                <TextBlock Text="Lock" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <UniformGrid Rows="1">
                        <ToggleButton Tag="caffeine" Style="{StaticResource IconToggle}" Content="&#xE945;" ToolTip="Keep awake" Click="Caffeine_Click" />
                        <ToggleButton Tag="mic" Style="{StaticResource IconToggle}" Content="&#xEC54;" ToolTip="Mute microphone everywhere" Click="Mic_Click" />
                        <ToggleButton Tag="hide" Style="{StaticResource IconToggle}" Content="&#xEA18;" ToolTip="Hide NotchX from screen capture" Click="Hide_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE7A8;" ToolTip="Screen capture (copies to the clipboard)" Click="Capture_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE790;" ToolTip="Colour eyedropper" Click="Eyedropper_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Command palette" Click="Palette_Click" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Bluetooth devices -->
            <Border Tag="bluetooth" Style="{StaticResource Card}" Padding="10,6,6,8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Bluetooth settings" Click="BtSettings_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh" Click="BtRefresh_Click" />
                        <TextBlock Text="BLUETOOTH" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </DockPanel>
                    <TextBlock x:Name="BtEmpty" DockPanel.Dock="Top" Style="{StaticResource Caption}" Text="No paired devices" Margin="2,6,0,0" TextWrapping="Wrap" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="BtList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButton}" Background="Transparent" Padding="4,4" Margin="0,0,0,1"
                                            HorizontalContentAlignment="Stretch" Click="BtDevice_Click" Opacity="{Binding Opacity}"
                                            ToolTip="Connect or disconnect in quick settings">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" Width="24" />
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{Binding BatteryGlyph}" FontSize="14" Margin="4,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Status}" FontSize="10" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
