<UserControl x:Class="Notchify.Views.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource ChipButton}" Click="Zip_Click" Margin="0,0,6,0" ToolTip="Compress the selection (or everything) into a .zip">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="Zip" /></StackPanel>
            </Button>
            <Button Style="{StaticResource ChipButton}" Click="Unzip_Click" Margin="0,0,6,0" ToolTip="Expand selected archives">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="Unzip" /></StackPanel>
            </Button>
            <Button x:Name="ConvertButton" Style="{StaticResource ChipButton}" Click="Convert_Click" Margin="0,0,6,0" ToolTip="Convert selected images / PDFs">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="Convert ▾" /></StackPanel>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="PNG" Tag="png" Click="ConvertTo_Click" />
                        <MenuItem Header="JPEG" Tag="jpeg" Click="ConvertTo_Click" />
                        <MenuItem Header="TIFF" Tag="tiff" Click="ConvertTo_Click" />
                        <MenuItem Header="BMP" Tag="bmp" Click="ConvertTo_Click" />
                        <MenuItem Header="GIF" Tag="gif" Click="ConvertTo_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Style="{StaticResource ChipButton}" Click="Capture_Click" Margin="0,0,6,0" ToolTip="Capture a screen region onto the shelf">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A8;" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="Capture" /></StackPanel>
            </Button>
            <Button Style="{StaticResource ChipButton}" Click="Clear_Click" ToolTip="Remove everything from the shelf (files stay on disk)">
                <TextBlock Text="Clear" />
            </Button>
        </StackPanel>

        <ListBox x:Name="Tiles" Grid.Row="1" SelectionMode="Extended" PreviewMouseMove="Tiles_MouseMove"
                 PreviewMouseLeftButtonDown="Tiles_MouseDown" MouseDoubleClick="Tiles_DoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Margin" Value="0,0,6,6" />
                    <Setter Property="Width" Value="96" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel ToolTip="{Binding Path}">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="Open_Click" />
                                <MenuItem Header="Show in folder" Click="Reveal_Click" />
                                <MenuItem Header="Copy path" Click="CopyPath_Click" />
                                <MenuItem Header="Change icon…" Click="ChangeIcon_Click" />
                                <MenuItem Header="Reset icon" Click="ResetIcon_Click" IsEnabled="{Binding HasCustomIcon}" />
                                <MenuItem Header="Remove from shelf" Click="Remove_Click" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <Image Source="{Binding Thumbnail}" Height="52" Stretch="Uniform" Margin="0,2,0,4" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SizeText}" FontSize="9" HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="30" Foreground="{DynamicResource FaintTextBrush}" />
            <TextBlock Style="{StaticResource Body}" Text="Drop files here" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Caption}" Text="They stay until you drag them out — even across restarts" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
