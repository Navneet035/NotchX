<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build of NotchX.
  The $TOKENS$ are filled in by packaging/build-msix.ps1 (identity from packaging/identity.json,
  version from the project, architecture per build). Don't edit them here.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="$IDENTITY_NAME$"
    Publisher="$PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="$ARCH$" />

  <Properties>
    <DisplayName>NotchX</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <Description>A notch-style hub at the top of your screen for music, files, clipboard, desktops and more.</Description>
  </Properties>

  <Dependencies>
    <!-- Same minimum as the app itself (net8.0-windows10.0.19041.0): Windows 10 2004. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="NotchX" Executable="NotchX.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="NotchX"
        Description="A notch-style hub at the top of your screen for music, files, clipboard, desktops and more."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows" for the Store build (the zip build uses the Run key instead). -->
        <desktop:Extension Category="windows.startupTask" Executable="NotchX.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="NotchXStartup" Enabled="false" DisplayName="NotchX" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A normal desktop app: needed for the keyboard hook (volume / Caps Lock HUDs), watching other windows
         (virtual desktops, media sessions) and the tray icon. Explained in packaging/README.md for certification. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
